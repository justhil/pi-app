        "historyMaxTokens": "Max history tokens",
        "midRunGuardEnabled": "Mid-run guard",
        "showAfterCompact": "Show after compaction",
        "continuationArtifactMode": "Continuation artifact output",
        "agentGuidePath": "AGENTS.md path",
        "agentGuideSyncMode": "Guide sync mode",
        "promptOverridePolicy": "Prompt override policy",
        "appendCompactionMetadata": "Append compaction metadata",
