    },
    "ru": {
      "displayName": "Continue",
      "description": "Продолжение с середины задачи (настройки в ~/.pi/agent/extensions/pi-continue.json)",
      "fieldLabels": {
        "enabled": "Включить продолжение",
        "summarizerModel": "Модель передачи",
        "reasoning": "Уровень рассуждений",
        "historyMaxTokens": "Макс. токенов истории",
        "midRunGuardEnabled": "Защита посреди выполнения",
