        "agentGuidePath": "Путь к AGENTS.md",
        "agentGuideSyncMode": "Режим синхронизации инструкции",
        "promptOverridePolicy": "Политика переопределения промпта",
        "appendCompactionMetadata": "Добавлять метаданные компакции",
        "appendReadFileTags": "Добавлять теги прочитанных файлов",
        "appendModifiedFileTags": "Добавлять теги изменённых файлов"
      },
      "fieldDescriptions": {
        "summarizerModel": "provider/model или inherit для наследования текущей модели",
        "historyMaxTokens": "Оставьте пустым или 0 для значения Pi по умолчанию"
      }
    }
  }
}
