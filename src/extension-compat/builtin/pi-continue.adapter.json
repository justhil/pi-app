        "reasoning": "推理等级",
        "historyMaxTokens": "历史最大 token",
        "midRunGuardEnabled": "中途守卫",
        "showAfterCompact": "压缩后显示",
        "continuationArtifactMode": "续跑产物写入",
        "agentGuidePath": "AGENTS.md 路径",
        "agentGuideSyncMode": "指南同步模式",
        "promptOverridePolicy": "提示词覆盖策略",
        "appendCompactionMetadata": "附加压缩元数据",
        "appendReadFileTags": "附加读取文件标签",
        "appendModifiedFileTags": "附加修改文件标签"
      },
      "fieldDescriptions": {
        "summarizerModel": "provider/model 或 inherit 继承当前模型",
        "historyMaxTokens": "留空/0 用 Pi 默认"
      }
    },
    "en": {
