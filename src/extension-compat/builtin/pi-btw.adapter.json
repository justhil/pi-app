{
  "id": "pi-btw",
  "displayName": "BTW",
  "description": "并行侧聊（斜杠状态输出）",
  "match": {
    "names": [
      "pi-btw"
    ],
    "commands": [
      "/btw",
      "/btw:tangent",
      "/btw:new",
      "/btw:clear",
      "/btw:inject",
      "/btw:summarize",
      "/btw:model",
      "/btw:thinking"
    ]
  },
  "install": {
    "source": "npm:pi-btw",
    "homepage": "https://github.com/dbachelder/pi-btw"
  },
  "tier": "headless",
  "config": {
    "note": "侧聊会话由扩展自管；桌面仅展示斜杠状态输出。",
    "i18n": {
      "zh": {
        "note": "侧聊会话由扩展自管；桌面仅展示斜杠状态输出。"
      },
      "en": {
        "note": "Side-chat sessions are managed by the extension; the desktop only displays slash command status output."
      },
      "ru": {
        "note": "Сессии побочного чата управляются расширением; desktop-клиент лишь показывает вывод статуса slash-команд."
      }
    }
  },
  "slash": {
    "/btw": "notify",
    "/btw:tangent": "notify",
    "/btw:new": "notify",
    "/btw:clear": "notify",
    "/btw:inject": "notify",
    "/btw:summarize": "notify",
    "/btw:model": "notify",
    "/btw:thinking": "notify"
  },
  "i18n": {
    "zh": {
      "displayName": "BTW",
      "description": "并行侧聊（斜杠状态输出）"
    },
    "en": {
      "displayName": "BTW",
      "description": "Parallel side-chat (slash command status output)"
    },
    "ru": {
      "displayName": "BTW",
      "description": "Параллельный побочный чат (вывод статуса slash-команд)"
    }
  }
}
