{
  "id": "pi-multimodal-proxy",
  "displayName": "Multimodal Vision",
  "description": "图像/视频分析代理（配置 ~/.pi/agent/multimodal-proxy.json）",
  "match": {
    "names": [
      "pi-multimodal-proxy"
    ],
    "tools": [
      "analyze_image"
    ]
  },
  "tier": "partial",
  "toolCard": {
    "template": "media",
    "icon": "Eye"
  },
  "config": {
    "configFile": "~/.pi/agent/multimodal-proxy.json",
    "fileKeyMap": {
      "mode": "mode",
      "provider": "provider",
      "modelId": "modelId",
      "systemPrompt": "systemPrompt",
      "includeContext": "includeContext",
      "tool": "tool",
      "maxImagesPerCall": "maxImagesPerCall",
      "maxBatch": "maxBatch",
      "cacheSize": "cacheSize",
      "videoProvider": "videoProvider",
      "videoModelId": "videoModelId"
    },
    "envOverride": {
      "mode": "PI_VISION_PROXY_MODE",
      "provider": "PI_VISION_PROXY_PROVIDER",
      "modelId": "PI_VISION_PROXY_MODEL",
      "includeContext": "PI_VISION_PROXY_CONTEXT",
      "tool": "PI_VISION_PROXY_TOOL",
      "maxImagesPerCall": "PI_VISION_PROXY_MAX_IMAGES",
      "maxBatch": "PI_VISION_PROXY_MAX_BATCH",
      "cacheSize": "PI_VISION_PROXY_CACHE_SIZE",
      "videoProvider": "PI_VISION_PROXY_VIDEO_PROVIDER",
      "videoModelId": "PI_VISION_PROXY_VIDEO_MODEL"
    },
    "localKeys": [
      "showInlinePreview"
    ],
    "sections": [
      {
        "title": "代理模式",
        "fields": [
          {
            "key": "mode",
            "type": "select",
            "label": "代理模式",
            "default": "fallback",
            "description": "fallback=仅当模型不支持图时启用；always=总是启用；off=关闭",
            "options": [
              "fallback",
              "always",
              "off"
            ]
          },
          {
            "key": "tool",
            "type": "select",
            "label": "工具调用",
            "default": "on",
            "options": [
              "on",
              "off"
            ]
          }
        ],
        "i18n": {
          "zh": {
            "title": "代理模式"
          },
          "en": {
            "title": "Proxy Mode"
          },
          "ru": {
            "title": "Режим прокси"
          }
        }
      },
      {
        "title": "图像模型",
        "fields": [
          {
            "key": "provider",
            "type": "text",
            "label": "Provider",
            "default": "anthropic",
            "description": "模型提供商标识（如 anthropic / CloseAI），需已 pi --login"
          },
          {
            "key": "modelId",
            "type": "text",
            "label": "图像分析模型 ID",
            "default": "claude-sonnet-4-5"
          },
          {
            "key": "systemPrompt",
            "type": "text",
            "label": "系统提示词",
            "description": "留空使用扩展默认"
          },
          {
            "key": "includeContext",
            "type": "boolean",
            "label": "包含会话上下文",
            "default": false
          },
          {
            "key": "maxImagesPerCall",
            "type": "number",
            "label": "每次调用最大图片数",
            "default": 10
          },
          {
            "key": "maxBatch",
            "type": "number",
            "label": "最大批处理数",
            "default": 4
          },
          {
            "key": "cacheSize",
            "type": "number",
            "label": "缓存大小",
            "default": 50
          }
        ],
        "i18n": {
          "zh": {
            "title": "图像模型"
          },
          "en": {
            "title": "Image Model"
          },
          "ru": {
            "title": "Модель изображений"
          }
        }
      },
      {
        "title": "视频模型",
        "fields": [
          {
            "key": "videoProvider",
            "type": "text",
            "label": "视频 Provider",
            "default": "xai"
          },
          {
            "key": "videoModelId",
            "type": "text",
            "label": "视频分析模型 ID",
            "default": "grok-4.3-high"
          }
        ],
        "i18n": {
          "zh": {
            "title": "视频模型"
          },
          "en": {
            "title": "Video Model"
          },
          "ru": {
            "title": "Видеомодель"
          }
        }
      },
      {
        "title": "桌面卡片",
        "fields": [
          {
            "key": "showInlinePreview",
            "type": "boolean",
            "label": "时间线内联图像预览",
            "default": true
          }
        ],
        "i18n": {
          "zh": {
            "title": "桌面卡片"
          },
          "en": {
            "title": "Desktop Card"
          },
          "ru": {
            "title": "Карточка в desktop"
          }
        }
      }
    ],
    "note": "配置写入 ~/.pi/agent/multimodal-proxy.json（与扩展共享）。provider/modelId 需对应已 pi --login 的模型。showInlinePreview 为桌面本地开关。",
    "i18n": {
      "zh": {
        "note": "配置写入 ~/.pi/agent/multimodal-proxy.json（与扩展共享）。provider/modelId 需对应已 pi --login 的模型。showInlinePreview 为桌面本地开关。"
      },
      "en": {
        "note": "Writes ~/.pi/agent/multimodal-proxy.json (shared with the extension). provider/modelId must match a model signed in via pi --login. showInlinePreview is a desktop-only toggle."
      },
      "ru": {
        "note": "Записывает в ~/.pi/agent/multimodal-proxy.json (общий с расширением). provider/modelId должны соответствовать модели, авторизованной через pi --login. showInlinePreview — локальный переключатель desktop."
      }
    }
  },
  "slash": {
    "/multimodal-proxy": "config-page",
    "/vision-proxy": "config-page"
  },
  "i18n": {
    "zh": {
      "displayName": "Multimodal Vision",
      "description": "图像/视频分析代理（配置 ~/.pi/agent/multimodal-proxy.json）",
      "fieldLabels": {
        "mode": "代理模式",
        "tool": "工具调用",
        "provider": "Provider",
        "modelId": "图像分析模型 ID",
        "systemPrompt": "系统提示词",
        "includeContext": "包含会话上下文",
        "maxImagesPerCall": "每次调用最大图片数",
        "maxBatch": "最大批处理数",
        "cacheSize": "缓存大小",
        "videoProvider": "视频 Provider",
        "videoModelId": "视频分析模型 ID",
        "showInlinePreview": "时间线内联图像预览"
      },
      "fieldDescriptions": {
        "mode": "fallback=仅当模型不支持图时启用；always=总是启用；off=关闭",
        "provider": "模型提供商标识（如 anthropic / CloseAI），需已 pi --login",
        "systemPrompt": "留空使用扩展默认"
      }
    },
    "en": {
      "displayName": "Multimodal Vision",
      "description": "Image/video analysis proxy (settings in ~/.pi/agent/multimodal-proxy.json)",
      "fieldLabels": {
        "mode": "Proxy mode",
        "tool": "Tool calls",
        "provider": "Provider",
        "modelId": "Image analysis model ID",
        "systemPrompt": "System prompt",
        "includeContext": "Include session context",
        "maxImagesPerCall": "Max images per call",
        "maxBatch": "Max batch size",
        "cacheSize": "Cache size",
        "videoProvider": "Video provider",
        "videoModelId": "Video analysis model ID",
        "showInlinePreview": "Inline image preview in timeline"
      },
      "fieldDescriptions": {
        "mode": "fallback = enable only when the active model lacks vision; always = always enable; off = disabled",
        "provider": "Model provider ID (e.g. anthropic / CloseAI), must be signed in via pi --login",
        "systemPrompt": "Leave blank to use the extension default"
      }
    },
    "ru": {
      "displayName": "Multimodal Vision",
      "description": "Прокси анализа изображений и видео (настройки в ~/.pi/agent/multimodal-proxy.json)",
      "fieldLabels": {
        "mode": "Режим прокси",
        "tool": "Вызов инструментов",
        "provider": "Провайдер",
        "modelId": "ID модели анализа изображений",
        "systemPrompt": "Системный промпт",
        "includeContext": "Включать контекст сессии",
        "maxImagesPerCall": "Макс. изображений за вызов",
        "maxBatch": "Макс. размер пакета",
        "cacheSize": "Размер кэша",
        "videoProvider": "Видеопровайдер",
        "videoModelId": "ID модели анализа видео",
        "showInlinePreview": "Встроенный предпросмотр изображений в таймлайне"
      },
      "fieldDescriptions": {
        "mode": "fallback = включать, только если модель не поддерживает изображения; always = всегда включено; off = выключено",
        "provider": "Идентификатор провайдера (например anthropic / CloseAI), требуется вход через pi --login",
        "systemPrompt": "Оставьте пустым для значения расширения по умолчанию"
      }
    }
  }
}
