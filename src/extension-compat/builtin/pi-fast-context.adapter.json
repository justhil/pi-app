        "maxResults": "最大结果数",
        "timeoutSecs": "超时（秒）",
        "repoMapMode": "Repo Map 模式",
        "excludePaths": "排除路径（逗号分隔）",
        "bootstrapEnabled": "启用 Bootstrap",
        "bootstrapTreeDepth": "Bootstrap 树深度",
