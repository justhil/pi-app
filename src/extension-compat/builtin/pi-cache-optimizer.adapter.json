{
  "id": "pi-cache-optimizer",
  "displayName": "Cache Optimizer",
  "description": "提高提示词缓存命中：功能开关写入 ~/.pi/agent/pi-cache-optimizer-config.json",
  "match": {
    "names": [
      "pi-cache-optimizer"
    ],
    "commands": [
      "/cache-optimizer"
    ]
  },
  "tier": "headless",
  "config": {
    "configFile": "~/.pi/agent/pi-cache-optimizer-config.json",
    "fileConstants": {
      "version": 3
    },
    "fileKeyMap": {
      "promptRewrite": "features.promptRewrite",
      "skillCompression": "features.skillCompression",
      "openAICacheKey": "features.openAICacheKey",
      "virtualRewrite": "features.virtualRewrite",
      "toolOrder": "features.toolOrder"
    },
    "sections": [
      {
        "title": "功能",
        "fields": [
          {
            "key": "promptRewrite",
            "type": "boolean",
            "label": "稳定系统提示词",
            "default": true,
            "description": "重排易变内容，提高前缀缓存命中"
          },
          {
            "key": "skillCompression",
            "type": "boolean",
            "label": "压缩技能列表",
            "default": true
          },
          {
            "key": "openAICacheKey",
            "type": "boolean",
            "label": "OpenAI cache key",
            "default": true,
            "description": "给 OpenAI 兼容请求加 prompt_cache_key"
          },
          {
            "key": "virtualRewrite",
            "type": "boolean",
            "label": "虚拟改写",
            "default": false,
            "description": "实验性"
          },
          {
            "key": "toolOrder",
            "type": "boolean",
            "label": "固定工具顺序",
            "default": false
          }
        ],
        "i18n": {
          "zh": {
            "title": "功能"
          },
          "en": {
            "title": "Features"
          }
        }
      }
    ],
    "note": "与扩展 /cache-optimizer 的功能开关是同一份文件，优先于环境变量；新会话生效。带参数的 /cache-optimizer（如 status、stats）照常交给扩展执行。",
    "i18n": {
      "zh": {
        "note": "与扩展 /cache-optimizer 的功能开关是同一份文件，优先于环境变量；新会话生效。带参数的 /cache-optimizer（如 status、stats）照常交给扩展执行。"
      },
      "en": {
        "note": "Same file as the extension's /cache-optimizer feature switches; overrides environment variables and applies to new sessions. /cache-optimizer with arguments (status, stats…) still runs in the extension."
      }
    }
  },
  "slash": {
    "/cache-optimizer": "config-page"
  },
  "i18n": {
    "zh": {
      "displayName": "Cache Optimizer",
      "description": "提高提示词缓存命中：功能开关写入 ~/.pi/agent/pi-cache-optimizer-config.json",
      "fieldLabels": {
        "promptRewrite": "稳定系统提示词",
        "skillCompression": "压缩技能列表",
        "openAICacheKey": "OpenAI cache key",
        "virtualRewrite": "虚拟改写",
        "toolOrder": "固定工具顺序"
      },
      "fieldDescriptions": {
        "promptRewrite": "重排易变内容，提高前缀缓存命中",
        "openAICacheKey": "给 OpenAI 兼容请求加 prompt_cache_key",
        "virtualRewrite": "实验性"
      }
    },
    "en": {
      "displayName": "Cache Optimizer",
      "description": "Better prompt cache hit rates: feature switches in ~/.pi/agent/pi-cache-optimizer-config.json",
      "fieldLabels": {
        "promptRewrite": "Stable system prompt",
        "skillCompression": "Compress the skill list",
        "openAICacheKey": "OpenAI cache key",
        "virtualRewrite": "Virtual rewrite",
        "toolOrder": "Stable tool order"
      },
      "fieldDescriptions": {
        "promptRewrite": "Moves volatile content so the prompt prefix stays cacheable",
        "openAICacheKey": "Adds prompt_cache_key to OpenAI-compatible requests",
        "virtualRewrite": "Experimental"
      }
    }
  }
}
