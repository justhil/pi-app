{
  "id": "pi-subagents",
  "displayName": "Subagents",
  "description": "子代理委派：subagent 工具卡片展开子会话进度；设置读写 ~/.pi/agent/extensions/subagent/config.json",
  "match": {
    "names": [
      "pi-subagents"
    ],
    "tools": [
      "subagent",
      "contact_supervisor",
      "structured_output"
    ],
    "commands": [
      "/run",
      "/subagents",
      "/subagents-stop",
      "/subagents-steer",
      "/subagents-detach",
      "/subagents-doctor",
      "/subagents-guide",
      "/subagents-refine",
      "/subagents-fleet",
      "/subagents-inspect-rpc",
      "/subagents-models",
      "/subagents-profiles",
      "/subagents-load-profile",
      "/subagents-refresh-provider-models",
      "/subagents-generate-profiles",
      "/subagents-check-profile",
      "/subagents-watchdog",
      "/subagent-cost",
      "/prompt-workflow",
      "/pi-subagents-bridge"
    ]
  },
  "tier": "partial",
  "toolCard": {
    "template": "tree",
    "icon": "GitBranch",
    "childSession": {
      "layout": "parent-session-run-directory",
      "runIdPath": "$.runId",
      "resultIndexPath": "$.progress.index",
      "progressIndexPath": "$.index",
      "childDirectoryPrefix": "run-",
      "fileName": "session.jsonl"
    }
  },
  "config": {
    "configFile": "~/.pi/agent/extensions/subagent/config.json",
    "fileKeyMap": {
      "asyncByDefault": "asyncByDefault",
      "forceTopLevelAsync": "forceTopLevelAsync",
      "defaultSubagentContext": "defaultSubagentContext",
      "maxSubagentDepth": "maxSubagentDepth",
      "worktree": "worktree"
    },
    "sections": [
      {
        "title": "默认行为",
        "fields": [
          {
            "key": "asyncByDefault",
            "type": "boolean",
            "label": "默认后台运行",
            "default": true
          },
          {
            "key": "forceTopLevelAsync",
            "type": "boolean",
            "label": "顶层调用强制后台运行",
            "default": true
          },
          {
            "key": "defaultSubagentContext",
            "type": "select",
            "label": "子代理上下文",
            "options": [
              "fresh",
              "fork"
            ],
            "description": "fresh 从空白开始；fork 带上当前会话。未设置时按各代理自己的默认值"
          },
          {
            "key": "maxSubagentDepth",
            "type": "number",
            "label": "最大子代理嵌套深度",
            "default": 1
          },
          {
            "key": "worktree",
            "type": "boolean",
            "label": "在独立 worktree 中运行",
            "default": false
          }
        ],
        "i18n": {
          "zh": {
            "title": "默认行为"
          },
          "en": {
            "title": "Defaults"
          }
        }
      }
    ],
    "note": "子代理由扩展执行；桌面按工具结果的 runId / progress 展开子会话。其余设置（forkContext、intercomBridge 等）请直接编辑配置文件。",
    "i18n": {
      "zh": {
        "note": "子代理由扩展执行；桌面按工具结果的 runId / progress 展开子会话。其余设置（forkContext、intercomBridge 等）请直接编辑配置文件。"
      },
      "en": {
        "note": "Subagents run in the extension; the desktop follows runId / progress to show child sessions. Edit the file for the other settings (forkContext, intercomBridge…)."
      }
    }
  },
  "i18n": {
    "zh": {
      "displayName": "Subagents",
      "description": "子代理委派：subagent 工具卡片展开子会话进度；设置读写 ~/.pi/agent/extensions/subagent/config.json",
      "fieldLabels": {
        "asyncByDefault": "默认后台运行",
        "forceTopLevelAsync": "顶层调用强制后台运行",
        "defaultSubagentContext": "子代理上下文",
        "maxSubagentDepth": "最大子代理嵌套深度",
        "worktree": "在独立 worktree 中运行"
      }
    },
    "en": {
      "displayName": "Subagents",
      "description": "Subagent delegation: subagent tool cards follow child sessions; settings in ~/.pi/agent/extensions/subagent/config.json",
      "fieldLabels": {
        "asyncByDefault": "Run in background by default",
        "forceTopLevelAsync": "Force top-level runs async",
        "defaultSubagentContext": "Subagent context",
        "maxSubagentDepth": "Max subagent nesting depth",
        "worktree": "Run in a separate worktree"
      },
      "fieldDescriptions": {
        "defaultSubagentContext": "fresh starts empty; fork carries the current session. Unset uses each agent's own default"
      }
    }
  }
}
